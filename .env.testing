# Test-only environment. TRACKED ON PURPOSE.
#
# This file exists so the test suite can never fall back to .env, whose DB_HOST and
# DB_DATABASE point at a real database. RefreshDatabase runs migrate:fresh, which
# DROPS EVERY TABLE in whatever it is pointed at.
#
# APP_KEY below is a FIXED, DELIBERATELY FAKE key. It is safe to commit precisely
# because it protects nothing: it is used only by the test suite, which runs against
# an in-memory SQLite database that is created and destroyed per test.
# Do NOT run `php artisan key:generate` against this file -- that would write a real
# key into a tracked file and invite committing it.
# A key must be present and non-empty, or Laravel throws "No application encryption
# key has been specified" for anything touching sessions, cookies or encryption,
# which is the entire Feature suite.
APP_NAME="Store Syria (testing)"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BCRYPT_ROUNDS=4
CACHE_STORE=array
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
QUEUE_DRIVER=sync
BROADCAST_DRIVER=log
MAIL_MAILER=array
MAIL_DRIVER=array
