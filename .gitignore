# `/public/uploads` WITHOUT the trailing slash, so the rule covers a SYMLINK too.
# With the slash it matched only a directory, and `artisan serve` serves `public/` while the
# application's `theme` disk writes to the REPO ROOT `uploads/` (all 337 tracked upload files are
# there, none under public/) -- so a dev environment needs `public/uploads -> ../uploads` to see
# what the app uploaded, and that symlink was showing up as untracked and could have been
# committed by a `git add -A`. The intent of this rule has always been "never track public
# uploads"; this makes it hold for the symlink as well.
/public/uploads

# The DEV FIXTURE's own uploads. `database/seed-p2dev.php` creates store 1 and writes its images
# to the repo-root `uploads/` where the application's `theme` disk really writes, and a browser
# test that uploads a cover image lands there too. Store 1 exists only in a developer's local
# database -- NOTHING under `uploads/1/` is tracked, while 407 files under other store ids are --
# so these are regenerable test artefacts, not product content, and a `git add -A` must not sweep
# them into a commit. Ignored by store id rather than by filename because the seeder and the
# browser tests use different naming.
/uploads/1/

# THE SAME ARTEFACTS AT THE DOUBLED PREFIX, which is where the application REALLY writes them.
# `Utility::upload_file()` and `keyWiseUpload_file()` prepend `uploads/` to a `$dir` their callers
# already build as `uploads/<store id>`, so a product cover image or gallery image for store 1
# lands at `uploads/uploads/1/` -- not at `uploads/1/`, which the rule above covers.
# `StoredPathPolicy::resolve()` already documents that doubled prefix and peels it before reading
# the tenant segment. Found when the F196/F199 bite runs -- which deliberately let the upload
# branch execute -- left two files there that `git status` reported as untracked and a `git add -A`
# would have committed. 105 files under OTHER store ids are tracked at this path and stay tracked.
/uploads/uploads/1/
/vendor/
/node_modules/

# Keep the storage/ directory TREE in version control (.gitkeep placeholders) while
# ignoring its CONTENTS. Previously the blanket `/storage/` rule meant a fresh clone
# had no storage/ at all, so the application could not boot from source.
/storage/*
!/storage/app/
/storage/app/*
!/storage/app/public/
/storage/app/public/*
!/storage/framework/
/storage/framework/*
!/storage/framework/cache/
/storage/framework/cache/*
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/sessions/
/storage/framework/sessions/*
!/storage/framework/testing/
/storage/framework/testing/*
!/storage/framework/views/
/storage/framework/views/*
!/storage/logs/
/storage/logs/*
!.gitkeep
/public/storage

# Secrets must never be committed again. .env is already in history (commit 3c39c160)
# and its credentials must be treated as compromised and rotated; this rule only stops
# it recurring. .env.testing is tracked ON PURPOSE: it holds no secret and it is what
# stops the suite falling back to .env.
.env
.env.*
!.env.example
!.env.testing

# Artefacts that should never have been committed.
/error_log
composer.phar
/_active', 1)
.DS_Store

# PHPUnit's per-run cache. Regenerated on every run and machine-specific; it has no
# business in version control and shows up as an untracked file after any test run.
.phpunit.result.cache
.phpunit.cache

# Personal Claude Code configuration; project configuration is .claude/settings.json
.claude/settings.local.json
CLAUDE.local.md

# Written by the vendored paytabscom/laravel_paytabs package (not by this repository) into the
# application root whenever a PayTabs code path runs, which the Feature suite does. Regenerated on
# every run, so it shows up as an untracked file and makes the tree look dirty after any test run.
/debug_paytabs.log

# P2: the local dev database the screenshot harness seeds (database/seed-p2dev.php builds it).
# Never committed: it is a database, and the repository has a standing rule against those.
database/p2dev.sqlite
