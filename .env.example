APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================================
# LYNOMIA CHAT INTEGRATION  (packages/workdo/LynomiaChat)
# =============================================================================================
#
# None of these is written to the database, ever. APP_KEY is published and unrotated in this
# installation, so Laravel's `encrypted` cast protects nothing here -- every credential below is
# read from the environment per use and is never persisted, cast, logged or serialised.
#
# The module ships DISABLED and performs no remote call while disabled. Leave it that way until
# the Lynomia side exists and its ids are recorded.
#
# Authority on what each one does, and what breaks when it is wrong:
#   docs/development/lynomia-integration/PHASE-7-PREREQUISITES.md

# --- the switch ------------------------------------------------------------------------------
# false = no surface and no scheduled sweep performs a remote call. This is also the rollback
# lever: flipping it back to false is instant and total.
LYNOMIA_INTEGRATION_ENABLED=false

# --- REQUIRED once enabled. There is no sensible default for any of these. --------------------
# Absolute, https, no trailing slash.
LYNOMIA_BASE_URL=
# The PlatformApp token minted in Lynomia Super Admin. Server-to-server. Never commit a real one.
LYNOMIA_PLATFORM_TOKEN=
# 32+ random bytes, this installation's own: openssl rand -hex 32
# Every per-store webhook secret AND the platform feed's secret are DERIVED from this, so it must
# differ between environments. Rotating it invalidates every registered subscription at once.
LYNOMIA_WEBHOOK_MASTER_SECRET=

# --- REQUIRED for platform operational notices (P6D/P6E). Null until provisioned. -------------
# Store Syria's OWN Lynomia workspace -- never a merchant's. Pointed at a merchant's account and
# inbox, this sends from that merchant's WhatsApp channel, and Lynomia's UTILITY-only gate does
# not apply either, because that gate keys on the account being platform_owned.
# Leaving these empty is correct and safe: platform communications are simply unavailable.
LYNOMIA_PLATFORM_WORKSPACE_ACCOUNT_ID=
LYNOMIA_PLATFORM_WORKSPACE_SENDER_USER_ID=
LYNOMIA_PLATFORM_WORKSPACE_INBOX_ID=

# --- identity: changing this after any store is linked is a breaking change -------------------
# Forms the qualified store identifier {installation_ref}:{store_id} that Lynomia persists.
# Defaults to the HOST of APP_URL, so moving APP_URL silently changes it -- and because the
# qualified id is written to lynomia_store_links.commerce_external_store_id on first use, the two
# then disagree. Set it explicitly in any environment that will outlive one hostname.
LYNOMIA_INSTALLATION_REF=

# --- feature flags ----------------------------------------------------------------------------
# Commerce events are OFF by default. Required for the order/cart feed to reach an agent's panel.
LYNOMIA_COMMERCE_EVENTS_ENABLED=false
# Region used to interpret locally-written phone numbers when matching a shopper (ISO 3166-1).
LYNOMIA_COMMERCE_PHONE_REGION=SY

# --- credentials in memory --------------------------------------------------------------------
# MUST stay `array`. `file` or `database` writes a live Lynomia bearer token to disk, or to a
# database whose APP_KEY is published. That is the mistake the retired Chatwoot integration made.
LYNOMIA_CREDENTIAL_CACHE_STORE=array
LYNOMIA_CREDENTIAL_TTL_SECONDS=3600

# --- outbound HTTP ------------------------------------------------------------------------------
LYNOMIA_HTTP_TIMEOUT=10
LYNOMIA_HTTP_CONNECT_TIMEOUT=5
LYNOMIA_HTTP_RETRIES=2
LYNOMIA_HTTP_RETRY_DELAY_MS=250

# --- inbound: signature freshness and rate limits -----------------------------------------------
# Replay window, in seconds, on X-Chatwoot-Timestamp. Both hosts must be NTP-synchronised: skew
# beyond this rejects every delivery, and Lynomia does not retry an account webhook.
LYNOMIA_WEBHOOK_TOLERANCE_SECONDS=300
# Per verified store, behind the signature check, and the only knob that scales what merchants
# can deliver: the ceiling over all merchants is ten times this in code, and the shared tier in
# front of the signature check is that plus the platform budget below. Raising this raises all
# three. A 429 here DESTROYS the delivery -- Lynomia does not retry an account webhook.
LYNOMIA_INGRESS_RATE_PER_MINUTE=600
# One global bucket for the platform delivery feed; only a verified delivery reaches it.
LYNOMIA_PLATFORM_INGRESS_RATE_PER_MINUTE=600
# NOT the shared ceiling. The small allowance for a request carrying no signature header at all
# -- a header lookup, before any HMAC -- which a real delivery never pays.
LYNOMIA_INGRESS_UNVERIFIED_RATE_PER_MINUTE=300
# Per merchant, per hour, across every number they try (B4 contact verification).
LYNOMIA_CONTACT_VERIFY_RATE_PER_HOUR=10
# Per merchant, for the automation/flow studio surfaces.
LYNOMIA_STUDIO_RATE_PER_MINUTE=240
# The commerce API Lynomia reads orders and customers through. Per VERIFIED store, and the ONLY
# knob that scales merchant throughput: the whole-installation ceiling is derived from it in code
# at ten times this value, so raising this raises both. Several calls per panel open, so it is
# higher than it first looks; it is an abuse ceiling rather than a queue, and Lynomia does NOT
# retry a 429.
LYNOMIA_COMMERCE_RATE_PER_MINUTE=600
# NOT the installation ceiling. The small allowance for a request whose Authorization header does
# not even carry an `lsc_`-shaped bearer token -- a string comparison, before any HMAC or database
# read, and never paid by Lynomia. Setting it high costs nothing a merchant can feel; setting it
# low does not restrict Lynomia.
LYNOMIA_COMMERCE_UNVERIFIED_RATE_PER_MINUTE=120

# --- retention and timing -------------------------------------------------------------------
LYNOMIA_EVENT_RETENTION_DAYS=14
LYNOMIA_COMMERCE_EVENT_RETENTION_DAYS=14
LYNOMIA_INBOX_POLL_SECONDS=10
LYNOMIA_LINK_TTL_MINUTES=60
LYNOMIA_PROVISIONING_LOCK_MINUTES=5

# --- operational notice templates -------------------------------------------------------------
# These are TEMPLATE NAMES that must exist and be APPROVED on the WhatsApp channel in the
# platform workspace. A name that does not exist there fails at send time, not at boot.
LYNOMIA_NOTICE_INTEGRATION_SUSPENDED=integration_suspended
LYNOMIA_NOTICE_CONTACT_VERIFICATION=contact_verification
LYNOMIA_NOTICE_LANGUAGE=en_US
